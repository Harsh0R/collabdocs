{
  "name": "collabdocs",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/sync",
    "packages/database"
  ],
  "scripts": {
    "dev": "concurrently -k -n WEB,API,SYNC \"npm run dev -w @collabdocs/web\" \"npm run dev -w @collabdocs/api\" \"npm run dev -w @collabdocs/sync\"",
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev -w @collabdocs/web",
    "dev:api": "npm run dev -w @collabdocs/api",
    "dev:sync": "npm run dev -w @collabdocs/sync",
    "db:generate": "npm run db:generate -w @collabdocs/database",
    "db:validate": "npm run db:validate -w @collabdocs/database",
    "db:migrate": "npm run db:migrate -w @collabdocs/database",
    "db:studio": "npm run db:studio -w @collabdocs/database"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
